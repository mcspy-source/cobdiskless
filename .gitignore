# =============================================================================
# CobDiskless .gitignore
#
# Policy: source, build system, and docs are tracked. Everything that can be
# regenerated by a build, or that is runtime state / machine-specific data /
# third-party payload, is ignored. When in doubt, do not commit a binary --
# the release tree stays source-only.
#
# IMPORTANT: directory patterns are anchored with a leading "/" so they only
# match at the repository root. Unanchored patterns such as "storage/" or
# "drivers/" match at ANY depth and would silently swallow legitimate source
# trees (include/CobDisklessCore/storage/, third_party/ipxe/src/drivers/, ...).
# Windows checkouts also default to core.ignorecase=true, which makes
# "Debug/" match "debug/" and "ARM/" match "arm/" -- another reason to anchor.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Out-of-source build trees (binaries, objects, PDBs, libs, generated files)
#    Root-anchored: only the top-level build directories are ignored.
# -----------------------------------------------------------------------------
/build/
/build_*/
/bin/
/out/
/lib/
/lib64/
/install/
/stage/
/dist/
/Release/
/Debug/
/x64/
/x86/
/ARM/
/ARM64/
/Win32/

# CMake / build-system generated files (anchored to the repo root so vendored
# Makefiles under third_party/ are never affected).
/CMakeCache.txt
/CMakeFiles/
/cmake_install.cmake
/CTestTestfile.cmake
/Testing/
/compile_commands.json
/CMakePresets.json
*.ninja
/.ninja_deps
/.ninja_log
/Makefile
/sln.docstates

# MSBuild / Visual Studio (generated or user-local). "*.user" and "*.suo" are
# extension-based and safe at any depth; the directories above are anchored.
/.vs/
*.suo
*.user
*.userosscache
*.sln.ide
*.vcxproj.user
*.vcxproj.filters.user
*.opendb
*.VC.db
*.VC.opendb
ipch/
*.aps
*.ncb
*.sdf
*.opensdf

# -----------------------------------------------------------------------------
# 2. Compiler / linker artifacts -- never commit next to sources
#    Extension patterns are deliberately unanchored: these must be caught
#    wherever they appear.
# -----------------------------------------------------------------------------
*.obj
*.o
*.lo
*.la
*.slo
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.gcda
*.gcno
*.gcov
*.su
*.mod
*.mod.c
*.bc
*.ll

# Debug symbols & incremental link state
*.pdb
*.idb
*.ilk
*.ilk.*
*.map
*.res

# Intermediate/deps files produced by GCC/Clang. Anchored-free but harmless.
*.d
*.gch
*.pch

# Note: tftp_boot/ holds the prebuilt iPXE bootloaders the clients actually
# boot from (ipxe.efi, snponly.efi, undionly.kpxe, realtek.kpxe). They are
# runtime artifacts rather than build output and are deliberately tracked.
# No ignore rule covers their extensions, so no negation is needed for them.

# -----------------------------------------------------------------------------
# 3. Diskless test images, disk dumps, and network captures
#    (large, machine-specific, and never safe to commit)
# -----------------------------------------------------------------------------
*.vhd
*.vhdx
*.vmdk
*.vdi
*.qcow2
*.qcow2.*
*.img
*.ima
*.raw
*.iso
*.wim
*.esd
*.avhd
*.avhdx

# Network packet captures
*.pcap
*.pcapng
*.cap
*.ntar
*.pktdump

# Partition / boot artifacts
*.mbr

# Raw firmware / disk sector dumps (raw .bin blobs: MBRs, option ROMs,
# iPXE preboot images). Build outputs are already covered by /build/, /bin/
# and each vendored tree's own .gitignore -- this catches stray copies.
*.bin

# -----------------------------------------------------------------------------
# 4. Registry hives, hive backups, and driver staging dumps
# -----------------------------------------------------------------------------
*.reg
*.reg.transacted.log
*.reg.bak
*.hiv
*.hives
# "reg save" and offline hive exports commonly use .hive -- the extension
# that was missing from this list. Machine-specific, never commit.
*.hive
NTUSER.DAT
ntuser.dat
UsrClass.dat
*.reg.save

# Raw hive dumps produced by reg save / reg export during debugging.
# Anchored: "hives/" at any depth would be too broad.
/regback/
/RegBack/
/hives/

# Driver staging / injection scratch (INF copy-paste + .sys drops)
*.PNF
*.inf.bak
*.sys.bak
/drivers_staged/
/driver_staging/

# -----------------------------------------------------------------------------
# 5. Windows update / servicing payloads (offline repair experiments)
# -----------------------------------------------------------------------------
*.msu
*.cab
*.psfx
*.mum

# -----------------------------------------------------------------------------
# 6. Runtime state, caches, and machine-specific data
#    All anchored to the repository root. These directories are created by the
#    running server, not by the build, and must never shadow source trees such
#    as include/CobDisklessCore/storage/ or third_party/ipxe/src/drivers/.
# -----------------------------------------------------------------------------
/writeback/
/cache/
/games/
/images/
/drivers/
/storage/

# Server log + crash output
*.log
/server_crash.log

# Client enrollment registry and per-deployment station state (real MACs,
# hostnames, and IPs -- local operational data, not project source).
/clients.json
/stations.json
/storage_roles.conf

# Local deployment configuration. clients.conf and config.json are tracked
# defaults; these are the edited, host-specific copies.
/cobdiskless.conf

# HTTP/TFTP scratch served or fetched during live debugging
/resp.html

# Writeback COW overlays produced by tests/core_test.cpp (copy-on-write
# overlays, one per simulated client).  Zero are tracked; every one is
# runtime output.
*.cow

# Test fixture / scratch directories created at run time.  Anchored and
# underscore-suffixed so the tracked tests/ directory never matches.
/test_*/

# One-off diagnostic scratch under tools/.  Only tools/fix_vhd_payload.ps1 is
# project source -- it is named in the remediation hint printed by
# reg_bootstart.cpp -- so it is re-included and force-added; everything else
# here (probe output, service listings, hive dumps) is local state. The
# ad-hoc utilities that used to sit beside them now live in archive/.
/tools/*
!/tools/fix_vhd_payload.ps1

# -----------------------------------------------------------------------------
# 7. Archives, compressed payloads, and scratch media
# -----------------------------------------------------------------------------
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
*.gz
*.bz2
*.xz

# -----------------------------------------------------------------------------
# 8. One-off probe binaries
# -----------------------------------------------------------------------------
/dump_lba.exe
/inspect_csm.exe
*_probe.exe

# archive/tests/ keeps its legacy scratch SOURCES tracked so the archive is
# self-contained for anyone reading it later (otherwise a fresh clone would
# contain only the README). The large payloads that live alongside them --
# Windows installer blobs, images, hives, captures, and probe binaries -- are
# all excluded by the extension rules in sections 2, 3, 4, 5, 6 and 7 above,
# which is what keeps the archive free of multi-hundred-megabyte binaries.

# -----------------------------------------------------------------------------
# 9. Temporary files, backups, and OS/editor droppings
# -----------------------------------------------------------------------------
*.tmp
*.temp
*.bak
*.old
*.orig
*.rej
*.swp
*.swo
*~
*.sublime-workspace
/.idea/
/.vscode/
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Python/tooling caches (no Python in the build, but contributors use tools)
__pycache__/
*.pyc
/.pytest_cache/
/.cache/
/node_modules/

# -----------------------------------------------------------------------------
# 10. Environment / secrets
# -----------------------------------------------------------------------------
.env
.env.*
*.pem
*.key
*.p12
*.pfx
/secrets/
