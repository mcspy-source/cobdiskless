#!ipxe
echo =========================================================
echo CobDiskless Network Boot Initializing...
echo =========================================================
echo Connecting to CobDiskless SAN Target...
dhcp
set keep-san 1
sanhook --drive 0x80 iscsi:${next-server}::::iqn.2026-09.com.cobdiskless:storage
sanboot --drive 0x80
